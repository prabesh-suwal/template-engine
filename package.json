{
  "name": "docx-template-engine",
  "version": "1.0.0",
  "description": "A powerful DOCX template engine with JSON data injection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:check": "node build-check.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:simple": "ts-node examples/simple-test.ts",
    "test:real": "ts-node test-real.ts",
    "test:interactive": "ts-node interactive-test.ts",
    "example": "npm run build && node dist/examples/basic-example.js",
    "example:complex": "npm run build && node dist/examples/complex-example.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": ["docx", "template", "document", "generation", "pdf"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1",
    "jszip": "^3.10.1",
    "cheerio": "^1.0.0-rc.12",
    "chart.js": "^4.4.0",
    "canvas": "^2.11.2",
    "sharp": "^0.33.0",
    "axios": "^1.6.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/xml2js": "^0.4.14",
    "@types/mime-types": "^2.1.4",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}