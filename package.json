{
  "name": "docx-template-engine",
  "version": "1.0.0",
  "description": "A powerful DOCX template engine with JSON data injection and embedded web UI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:check": "node build-check.js",
    "build:server": "tsc && npm run copy:ui",
    "copy:ui": "cp -r ui dist/",
    "dev": "ts-node src/index.ts",
    "server": "npm run build:server && node dist/server.js",
    "server:dev": "ts-node server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:simple": "ts-node examples/simple-test.ts",
    "test:real": "ts-node test-real.ts",
    "test:interactive": "ts-node interactive-test.ts",
    "example": "npm run build && node dist/examples/basic-example.js",
    "example:complex": "npm run build && node dist/examples/complex-example.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "start": "npm run server",
    "start:dev": "npm run server:dev"
  },
  "keywords": [
    "docx",
    "template",
    "document",
    "generation",
    "pdf",
    "web",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "canvas": "^2.11.2",
    "chart.js": "^4.4.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/xml2js": "^0.4.14",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
